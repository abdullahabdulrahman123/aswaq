generator client {
  provider = "prisma-client-js"
}

/**
 * MongoDB Atlas — نفس كلاستر وصلة، قاعدة بيانات منفصلة اسمها aswaq.
 * مفيش migrations هنا — التحديث بـ`npm run db:push`.
 *
 * البيانات الأساسية (الحسابات، الأنشطة، الأسماء، العناوين) مش هنا — دي في وصلة.
 * accountId في كل جدول هنا هو id حساب النشاط في وصلة. مفيش علاقة حقيقية
 * بينهم لأنهم في قاعدتين مختلفتين، فالسيرفر بيتأكد منه بإنه يسأل وصلة نفسها
 * (شوف middleware/auth.ts).
 *
 * أسماء الحقول زي ما هي في السكيمة اللي العميل وافق عليها، من غير @map.
 */
datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URL")
}

/**
 * صنف. نفس الصنف بيتسجّل على مستويين — بطلب العميل:
 *   shopId = null → الصنف على مستوى النشاط، وده منبع البيانات
 *   shopId = id   → نسخة المتجر ده، بأسعاره ومعدلاته هو
 *
 * المتجر مش جدول هنا: هو مقر من مقرات النشاط في وصلة معلّم عليه «متجر»
 * (isStore)، والسيرفر بيتأكد منه من رد وصلة زي ما بيعمل مع النشاط نفسه.
 * يعني نشاط عنده ١٠ متاجر بيبقى عنده ١١ صف للصنف: واحد للشركة و١٠ للمتاجر.
 */
model Item {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  accountId String     @db.ObjectId
  /** id المقر (المتجر) في وصلة */
  shopId    String?    @db.ObjectId
  /**
   * نسخة المتجر: الصنف الأصلي (المرجع) اللي اتنسخت منه. بطلب العميل (٢٧ سبتمبر)
   * البيانات الأساسية من الأصل وبتتعمم على النسخ، والأسعار بس لكل متجر.
   * فاضي في الصنف الأصلي نفسه.
   */
  sourceItemId String? @db.ObjectId
  name      String
  picture   String?
  /** بالقرش. بيتحسب من المشتريات (متوسط مرجّح) — مش بيتكتب بإيد */
  avgCost   Int        @default(0)
  rate      Float      @default(0)
  isOwner   Boolean    @default(true)
  units     ItemUnit[]

  /**
   * الفهرس الفريد في MongoDB بيعامل null كقيمة واحدة (عكس Postgres).
   * هنا ده بالظبط المطلوب: صنف واحد بس بالاسم ده على مستوى النشاط.
   */
  @@unique([accountId, shopId, name])
  /** صفحة «إدارة أصناف المتاجر» بتسأل بالمتجر */
  @@index([shopId])
  @@index([sourceItemId])
  @@map("items")
}

/**
 * إعدادات البيع لمتجر — بطلب العميل «إعدادات خاصة بالمتاجر». المتجر نفسه مقر
 * في وصلة (shopId)، والإعدادات دي بتاعة البيع في أسواق بس، فمكانها هنا مش
 * هناك. صف واحد لكل متجر، بيتعمل أول ما صاحبه يحفظ حاجة فيه.
 *
 * دلوقتي نطاق التوصيل. الحد الأدنى لفاتورة الجملة هيتضاف هنا بعدين.
 */
model StoreSettings {
  id               String @id @default(auto()) @map("_id") @db.ObjectId
  accountId        String @db.ObjectId
  /** id المقر (المتجر) في وصلة */
  shopId           String @unique @db.ObjectId
  /** المتجر بيوصّل لحد المسافة دي بالكيلو من مكانه، بخط مستقيم. فاضي = مبيوصّلش */
  deliveryRadiusKm Float?
  /** الحد الأدنى للأوردر بالقرش لكل شريحة من الأسعار الأربعة. فاضي = مفيش حد أدنى */
  minSWP           Int?
  minSRP           Int?
  minLWP           Int?
  minLRP           Int?

  @@index([accountId])
  @@map("store_settings")
}

/**
 * الأوردر — بالسكيمة اللي العميل بعتها (٢٥ سبتمبر). مستند واحد بيعدّي على
 * حالات: draft (السلة قبل التأكيد) ← order (بعد التأكيد) ← … ← invoice (الكائن
 * المحاسبي). الحالة الحالية هنا برّه، والهيستوري هيبقى مستند لوحده بعدين.
 *
 * from = البائع: النشاط (acc) ومتجره (subAcc). to = المشتري: حساب في وصلة،
 * مستخدم أو نشاط (أو واحد من حسابين «غير مسجل»)، والـsubAcc بتاعه فاضي لحد ما
 * يتحدد. الحسابات كلها في وصلة، فمفيش علاقة حقيقية هنا.
 *
 * كل الفلوس بالقرش. السيرفر هو اللي بيحسب كل سعر من صنف المتجر — مبياخدش
 * سعر من المتصفح. البونص والخصم والضريبة صفر صريح لحد ما يتحددوا.
 */
model Order {
  id           String      @id @default(auto()) @map("_id") @db.ObjectId
  /** رقم الفاتورة — مسلسل لكل نشاط بائع، بيتاخد ساعة التأكيد. فاضي في المسودة */
  number       Int?
  /**
   * مراحل الأوردر (مكالمة ١ أكتوبر): draft (مسودة) ← «تأكيد» ← order (مؤكد) ←
   * … ← «إتمام» ← done (مكتمل). المكتمل بيخرج من «مهامي» وبيفضل محفوظ. اللي في
   * النص (تجهيز، تحميل…) كل نشاط بيختارها في إعداداته (BusinessSettings،
   * مكالمة ٢ أكتوبر) — والقالب في src/services/orderFlow.ts
   *
   * cancelled (ملغية، مكالمة ٥ أكتوبر): البائع أو المشتري لغاها بسبب — بتخرج من
   * «مهامي» زي المكتمل، والسبب ومين لغى في cancellation
   */
  state        String
  /**
   * مفتاح المسودة عند اللي عاملها: me:<shopId> لنفسه، <saleId>:<shopId> لبيعة.
   * مسودة واحدة لكل مفتاح — بعد التأكيد المسودة الجاية بتبقى مستند جديد.
   */
  ref          String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  checkedOutAt DateTime?
  /** ساعة «إتمام» */
  completedAt  DateTime?
  /** الإلغاء: مين لغى (البائع ولا المشتري) والسبب والساعة. فاضي = متلغتش */
  cancellation OrderCancellation?
  /**
   * الفاتورة جاية منين (مكالمة ١ أكتوبر): onsite = «مبيعات» (الشباك)، online =
   * المشتري من المعرض. الأوردرات اللي قبلها بتتملي ساعة ما السيرفر يقوم
   */
  source       String?
  /** المحرّر: المستخدم اللي عامل الأوردر (id حسابه في وصلة) */
  creator      OrderPerson
  /** آخر واحد عدّل الأوردر — «Creator or editor» في سكيمة العميل */
  editor       OrderPerson?
  /** البائع — مندوب البيع. دلوقتي المحرّر نفسه */
  seller       OrderPerson
  /** from.acc = النشاط البائع، وfrom.subAcc = الحساب الفرعي بتاع المتجر في وصلة */
  from         OrderParty
  to           OrderParty
  /** المقر (المتجر) اللي الأوردر منه — للرجوع لصفحته. الأوردرات الأولى من غيره: from.subAcc كان هو المقر */
  shopId       String?     @db.ObjectId
  /** للعرض والطباعة: نسخة من الأسامي ساعة الأوردر */
  names        OrderNames
  /** pickup | delivery */
  method       String
  /** عنوان التوصيل كتابة — «جنب الجامع الكبير» */
  address      String      @default("")
  /**
   * ميعاد التسليم (رسالة العميل ٦ أكتوبر): «واحد طالب دلوقتي بس عايزها يوم السبت».
   * الافتراضي ساعة التحرير. فاضي = الأوردرات اللي قبله
   */
  deliveryAt    DateTime?
  /** ملاحظات التسليم للسواق — «ابعت عمال ينزّلوا»، «بعد السوق عشان الشارع زحمة» */
  deliveryNotes String?
  /** بيانات بيعة «مبيعات» عشان ترجع زي ما هي على جهاز تاني. فاضي = المستخدم لنفسه */
  sale         Json?

  totalAvg       Int
  totalProfit    Int
  totalItems     Int
  totalTax       Int
  totalDiscount  Int
  /** totalItems − totalDiscount + totalTax */
  netTotal       Int
  totalDemanded  Int
  totalDeviation Int
  /** وزن الأوردر بالجرام: مجموع totalWeight بتاع السطور */
  totalWeight    Float
  /** حجم الأوردر بالسنتيمتر المكعب. اختياري عشان الأوردرات اللي قبل الحجم */
  totalVolume    Float?

  details OrderDetail[]

  @@index([creator.acc, ref, state])
  @@index([from.acc, number])
  @@map("orders")
}

type OrderPerson {
  acc  String @db.ObjectId
  name String
}

type OrderParty {
  acc    String  @db.ObjectId
  subAcc String? @db.ObjectId
}

/** مكالمة ٥ أكتوبر: «كانسل للفاتورة مع السبب، ومين اللي كانسل سيلر أو بايير» */
type OrderCancellation {
  /** seller | buyer */
  by     String
  /** اللي داس «إلغاء» — موظف البائع أو المشتري نفسه */
  person OrderPerson
  reason String
  at     DateTime
}

type OrderNames {
  business    String
  store       String
  /** الاسم الأدبي أو اسم الحساب */
  buyer       String
  buyerPhone  String @default("")
  /** user | business — بيحدد الجملة من القطاعي */
  buyerKind   String
}

/** سطر في الأوردر. demanded اللي المشتري طلبه، وdeviation الفرق بينه وبين اللي اتنفذ */
type OrderDetail {
  itemId         String      @db.ObjectId
  item           String
  unit           String
  unitContent    Int
  bonusQuantity  Int
  quantity       Int
  /** quantity + bonusQuantity */
  totalQuantity  Int
  originalPrice  Int
  discount       Int
  /** originalPrice − discount */
  price          Int
  tax            Int
  avg            Int
  /** price − avg */
  profit         Int
  /** quantity × price */
  totalItems     Int
  /** quantity × discount */
  totalDiscount  Int
  /** totalQuantity × tax — الضريبة على البونص كمان */
  totalTax       Int
  netTotal       Int
  /** وزن الوحدة بالجرام — والفاضي صفر، بطلب العميل: «النال هينللك الحسبة كلها» */
  weight         Float?
  /** حجم الوحدة بالسنتيمتر المكعب — والفاضي صفر */
  volume         Float?
  /** weight × totalQuantity — البونص بيتشال على العربية كمان */
  totalWeight    Float?
  /** volume × totalQuantity */
  totalVolume    Float?
  /** الوحدة ملهاش سعر في الشريحة دي — المسودة بتقبلها، والتأكيد لأ */
  unpriced       Boolean     @default(false)
  /** وزن الوحدة أو حجمها مش متسجّل (اتحسب صفر) — الفاتورة بتنبّه إن الإجمالي ممكن يبقى أقل */
  measuresMissing Boolean    @default(false)
  demanded       OrderAmount
  deviation      OrderAmount
}

type OrderAmount {
  quantity   Int
  unit       String
  price      Int
  tax        Int
  avg        Int
  totalItems Int
}

/**
 * إعدادات النشاط — بطلب العميل (مكالمة ٢ أكتوبر): الإعداد على المؤسسة كلها،
 * والصلاحية لفرد بعينه (دي في وصلة، business_employees). الإعدادات بتزيد مع كل
 * موضوع ندخل فيه. صف واحد لكل نشاط، بيتعمل أول ما صاحبه يحفظ.
 *
 * أول إعداد: مراحل البيع — من قالب أسواق (src/services/orderFlow.ts)، بالترتيب
 * اللي صاحب الشركة اختاره. فاضي = مؤكد ← مكتمل على طول.
 */
model BusinessSettings {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  /** id حساب النشاط في وصلة */
  businessId  String   @unique @db.ObjectId
  /** مفاتيح المراحل اللي بين «مؤكد» و«مكتمل»، بالترتيب */
  salesStages String[]
  /**
   * لون كل مرحلة (رسالة العميل ٦ أكتوبر: «هوية بصرية للحالة») — مفتاح المرحلة ←
   * مفتاح اللون من STAGE_COLOR_CHOICES. اللي مش هنا بياخد لونه الافتراضي. مؤكد
   * ومكتمل وملغية ألوانهم ثابتة (src/services/orderFlow.ts)
   */
  stageColors Json?
  updatedAt   DateTime @updatedAt

  @@map("business_settings")
}

/**
 * الصلاحيات — جدول system بتاع أسواق نفسه، مش بتاع نشاط (مكالمة ٢ أكتوبر):
 * «الرصيد» اللي كل الشركات بتاخد منه، وبيزيد كل ما نحتاج صلاحية جديدة. كل
 * صلاحية ليها قسم أو أكتر (مبيعات، حسابات…) عشان صاحب الشركة يفتح صلاحيات قسم
 * كامل لموظف. الموظف نفسه بيتسجل له المفتوح بس، في وصلة (business_employees).
 * بيتملى من الكود ساعة ما السيرفر يقوم (src/services/permissions.ts).
 */
model Permission {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  key        String   @unique
  name       String
  categories String[]
  /** بتتفتح للموظف الجديد لوحدها — «الحاجات اللي تعطل الشغل اعملها true» */
  defaultOn  Boolean
  sort       Int

  @@map("permissions")
}

/** عدّادات أرقام الفواتير — صف لكل نشاط بائع */
model Counter {
  id  String @id @map("_id")
  seq Int

  @@map("counters")
}

/** وحدة بيع. كل الأسعار بالقرش، والفاضي = لسه متحددش */
type ItemUnit {
  name        String
  /**
   * كام من أصغر وحدة جوه الوحدة دي — 1 = أصغر وحدة. كل الوحدات بالعدد (الدستة
   * ممكن تكون أصغر وحدة بمحتوى 1)، والـAPI بيقبل أعداد صحيحة بس.
   * فاضل Float عشان قيم اتكتبت كـdouble قبل كده متقعش وهي بتتقري.
   */
  unitContent Float
  /** متوسط تكلفة الوحدة بالقرش — بيتكتب بإيد، غير avgCost بتاع الصنف اللي بيتحسب */
  avgCost     Int?
  rate        Float?
  /** وزن الوحدة الواحدة بالجرام — التحميل على العربية بيقف عند أقصى وزن */
  weight      Float?
  /** حجم الوحدة الواحدة بالسنتيمتر المكعب — وبيقف كمان عند أقصى حجم */
  volume      Float?
  /** جملة في المحل */
  onSWP       Int?
  /** قطاعي في المحل */
  onSRP       Int?
  /** جملة أونلاين */
  onLWP       Int?
  /** قطاعي أونلاين */
  onLRP       Int?
}

/**
 * سجل الأخطاء (فحص ٦ أكتوبر): العميل فاهم إن كل خطأ بيتسجّل، وكان بيظهر في لوج
 * السيرفر بس. دلوقتي أخطاء السيرفر (٥٠٠) وأخطاء المتصفح (الصفحة اللي وقعت،
 * وأي خطأ ملوش حد يمسكه) بتتحفظ هنا، وبتتقري بـ`npm run errors`.
 */
model ErrorLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  at        DateTime @default(now())
  /** server | client */
  source    String
  message   String
  stack     String?
  /** client: الصفحة اللي كان عليها. server: METHOD /path */
  where     String?
  /** client: المتصفح والجهاز */
  userAgent String?
  /** المستخدم لو معروف (sub) — من المتصفح ممكن ميبقاش متأكد منه */
  userId    String?
  /** client: نسخة الموقع (الـbuild) — عشان نعرف الخطأ اتصلّح ولا لأ */
  version   String?

  @@index([at])
  @@map("error_logs")
}
