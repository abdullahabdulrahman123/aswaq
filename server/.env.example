PORT=5100

# نفس كلاستر Atlas بتاع وصلة، بس قاعدة بيانات تانية:
# انسخ MONGODB_URL من wasla/server/.env وغيّر /wasla اللي قبل علامة ? لـ/aswaq
MONGODB_URL=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/aswaq?retryWrites=true&w=majority

# سيرفر وصلة — أسواق بيسأله مع كل طلب: مين المستخدم؟ وإيه الأنشطة اللي بيديرها؟
WASLA_API_ORIGIN=http://localhost:5000

# أصول واجهة أسواق المسموح لها تنادي الـAPI من المتصفح (مفصولة بفاصلة)
CLIENT_ORIGINS=http://localhost:5184

# ————— النشر —————
# TRUST_PROXY=true   خلف بروكسي HTTPS (Render)
