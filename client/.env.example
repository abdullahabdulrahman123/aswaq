VITE_WASLA_ISSUER=http://localhost:5183/op
VITE_WASLA_CLIENT_ID=aswaq
# واجهة وصلة (صفحات الحساب) — أصل مختلف عن الـissuer
VITE_WASLA_ACCOUNT_ORIGIN=http://localhost:5183

# ————— خدمة العناوين —————
# فاضي = بنستخدم BigDataCloud المجانية (من غير حساب ولا كارت).
#   شروطها بتحصر الاستخدام في موقع الجهاز الحقيقي، فسحب الدبوس على الخريطة
#   بيغيّر الإحداثيات بس ومبيجيبش العنوان الجديد.
#
# لو اتحط مفتاح جوجل، بيتحوّل عليه تلقائياً:
#   • أدق في مصر
#   • سحب الدبوس بيجيب العنوان لأي نقطة
#   • ١٠٬٠٠٠ طلب مجاني في الشهر، وبعدها ٥ دولار لكل ١٠٠٠
#
# طريقة الحصول عليه:
#   console.cloud.google.com ← مشروع جديد ← فعّل "Geocoding API" ← اعمل مفتاح
#   ⚠️ مهم: قيّد المفتاح على دومين أسواق، وحط سقف استهلاك (Quota) عشان
#      أي استخدام غلط يتوقف بدل ما تيجي فاتورة.
VITE_GOOGLE_MAPS_API_KEY=

# ————— سيرفر أسواق (المحلات والأصناف) —————
# فاضي = صفحات الأصناف بتقول إن السيرفر مش متوصّل.
# محلياً: http://localhost:5100 · على النشر: رابط خدمة aswaq-api من Render
VITE_ASWAQ_API_ORIGIN=

# ————— صور الأصناف (Cloudinary) —————
# فاضي = زرار رفع الصورة بيتخفي والصنف يتحفظ من غير صورة.
# الاتنين دول مش أسرار — بيظهروا في كود الموقع عادي، والرفع unsigned preset.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
