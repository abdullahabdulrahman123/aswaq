# تسجيل الدخول عبر وصلة (Wasla)
#
# سيبهم فاضيين → أسواق بيشتغل بوضع تجريبي واضح (زرار دخول وهمي للعرض).
# املأهم وشغّل سيرفر وصلة → التسجيل الحقيقي عبر OIDC بيشتغل.
#
# لازم يكون أسواق مسجّل كتطبيق في وصلة:
#   wasla/server/src/oidc/clients.ts  →  client_id: 'aswaq'

VITE_WASLA_ISSUER=http://localhost:5000/op
VITE_WASLA_CLIENT_ID=aswaq
